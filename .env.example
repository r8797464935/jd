# Facebook Page that will own the event.
# The token must be a Page access token (not a user token) whose app has
# been granted the pages_manage_events permission via Facebook App Review.
FB_PAGE_ID=your_page_id
FB_PAGE_ACCESS_TOKEN=your_page_access_token

# SMTP credentials used to send invitation emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your_smtp_app_password
SENDER_NAME=Your Name
