# Facebook Page that will own the event.
# The token must be a Page access token (not a user token) whose app has
# been granted the pages_manage_events permission via Facebook App Review.
FB_PAGE_ID=your_page_id
FB_PAGE_ACCESS_TOKEN=your_page_access_token

# User access token used to send invites via Facebook's own invite system
# (POST /{event_id}/invited/{user_id}). Must belong to a host/admin of the
# event and be granted the user_events permission. Note: Facebook locked
# user_events down in its 2018 platform changes, so apps created since then
# are effectively unable to get it approved via App Review.
FB_USER_ACCESS_TOKEN=your_user_access_token
